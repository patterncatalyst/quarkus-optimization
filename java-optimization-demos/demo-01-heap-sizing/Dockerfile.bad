# ============================================================
# Demo 1 — BAD: JVM without container awareness
# This JVM will read HOST memory, not container limits!
# ============================================================
FROM eclipse-temurin:25-jdk AS builder
WORKDIR /build
COPY src/HeapInfo.java .
RUN javac HeapInfo.java

FROM eclipse-temurin:25-jre
WORKDIR /app
# Copy ALL compiled classes, including nested/record classes
# (HeapInfo$MemoryRegion.class) — copying only HeapInfo.class causes
# NoClassDefFoundError at runtime.
COPY --from=builder /build/*.class .

# ❌ Container support explicitly DISABLED to reproduce the classic failure.
#    On JDK 10+ UseContainerSupport is ON by default, so without this flag a
#    modern JVM would already respect the cgroup limit. Disabling it makes the
#    JVM read /proc/meminfo and see the HOST's full RAM — claiming ~25% of host
#    RAM as max heap even inside a 512m container (this is the pre-JDK-10 default
#    behavior that still bites teams running old images or overriding the flag).

ENTRYPOINT ["java", "-XX:-UseContainerSupport", "HeapInfo"]
